{
    "manifest_version": 3,

    "name": "Customizer",

    "version": "1.0.0",

    "description": "Customizer pour École Directe Plus",

    "permissions": [],

    "host_permissions": [
        "https://ecole-directe.plus/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://ecole-directe.plus/*"
            ],

            "js": [
                "content.js"
            ],

            "css": [
                "style.css"
            ],

            "run_at": "document_idle"
        }
    ]
}
